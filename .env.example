# ---------------------------------------------------------------------------
# Pick ONE. `sheldon check` prints which one it found.
# `.env` is loaded automatically and wins over variables already in the
# environment; `sheldon check` says when it overrode one.
# ---------------------------------------------------------------------------

# (a) An OpenAI-compatible endpoint — this is how a LiteLLM proxy is reached.
#     Paste the endpoint as-is; a trailing /chat/completions is stripped for you.
#     Setting OPENAI_BASE_URL is what selects provider=openai under `auto`.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Model names are whatever your endpoint serves. Through a proxy they are the
# proxy's aliases, not necessarily Anthropic's — override per run with
# `sheldon run --model <name>` or set `model:` in a config.

# Optional: point the harness at benchmark data outside the repo.
# SHELDON_DATA=/path/to/data
